    parameter Real 'DMOD.TNOM'(unit = "degC", quantity = "ThermodynamicTemperature") = 27.0 "Parameter measurement temperature";
    parameter Real 'DMOD.KF' = 0.0 "Flicker noise coefficient";
    parameter Real 'DMOD.AF' = 1.0 "Flicker noise exponent";
    parameter Real 'DMOD.G'(unit = "S", quantity = "Conductance") = 0.0 "Ohmic conductance";
    parameter Real 'QMOD.TNOM'(unit = "degC", quantity = "ThermodynamicTemperature") = 27.0 "Parameter measurement temperature";
